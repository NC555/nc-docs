{
  "markdown.editor.filePaste.copyIntoWorkspace": "mediaFiles",
  "files.exclude": {
    "**/.docusaurus/**": true,
    "**/.roo/**": true,
    "**/.ruru/**": true,
    "**/build/**": true,
    "**/docs/ansible/**": false,
    "**/docs/cyber-security/**": false,
    "**/docs/git/**": false,
    "**/docs/heap-knowledge-base/**": false,
    "**/docs/kubernetes/**": false,
    "**/docs/landing-zone-concepts/**": false,
    "**/docs/ms-windows/**": false,
    "**/docs/ubuntu-private-lab/**": false,
    "**/docs/linux/**": false,
    "**/.rooignore/**": true,
    "**/.roomodes/**": true,
    "**/node_modules/**": true,
    "**/static/downloads/**": true,
  },
  "markdown.copyFiles.destination": {
    "**/*": "/static/img/${documentBaseName}/${documentBaseName}.${fileName/(.*)\\.(.*)/$2/}"
  },
  "files.associations": {
    "*.mdx": "markdown"
  }
}